# =========================================================================
# workbuddy2api 环境变量模板
# -------------------------------------------------------------------------
# 用法：
#   1. 复制本文件为 .env：   cp .env.example .env
#   2. 按需修改下面的真实值（尤其是带 * 的敏感项）
#   3. .env 已被 .gitignore 忽略，绝不会提交到 git
#
# 注意：production 部署时，.env 中的值与本地开发不同，请单独在服务器创建。
# =========================================================================

# ---------- 数据库 / 缓存 ----------
# ★ 数据库配置中心：类型在这里切，参数在这里填。详见 admin/db_config.py 头部说明。
#
# 默认 SQLite（单文件库，零依赖，无需安装任何数据库服务），不配也能直接用。
# 只认 ADMIN_DB_NAME，把它当数据文件路径；主机 / 端口 / 账号密码都忽略。
# 相对路径以项目根目录为基准；目录不存在会自动创建，文件不存在会自动创建。
ADMIN_DB_TYPE=sqlite
ADMIN_DB_NAME=./data/workbuddy_admin.db     # 也可写绝对路径 D:/data/workbuddy_admin.db
# ADMIN_DB_NAME=:memory:                      # 内存库，进程退出即丢（仅测试用）
#
# 写法 A（切库：改用下面任一段即可，端口 / 用户 / 库名留空则取该类型默认值）
#   支持类型：sqlite（单文件，零依赖） | mysql（MySQL / MariaDB） | db2（IBM Db2 LUW）
#
# ---- 切到 MySQL（高并发生产推荐）----
# ADMIN_DB_TYPE=mysql
# ADMIN_DB_HOST=127.0.0.1
# ADMIN_DB_PORT=3306
# ADMIN_DB_USER=root
# # 生产必填：真实密码（密码里的 @ : / # 等特殊字符会自动 URL 转义）
# ADMIN_DB_PASSWORD=root
# ADMIN_DB_NAME=workbuddy_admin
#
# ---- 切到 DB2 ----
# ADMIN_DB_TYPE=db2
# ADMIN_DB_HOST=127.0.0.1
# ADMIN_DB_PORT=50000
# ADMIN_DB_USER=db2inst1
# ADMIN_DB_PASSWORD=你的密码
# ADMIN_DB_NAME=WBADMIN
# # DB2 专用：目标 schema（MySQL / SQLite 忽略此项）；留空则用 DB2 默认 schema（= 连接用户名大写）
# ADMIN_DB_SCHEMA=WBADMIN
#
# 方言原生附加参数串，写在 URL 的 ? 后面（SQLite 忽略；MySQL 默认 charset=utf8mb4）
# ADMIN_DB_OPTIONS=charset=utf8mb4
#
# 写法 B（兼容旧部署，显式连接串，优先级高于 A；方言从 URL 里自动识别）：
# ADMIN_DATABASE_URL=sqlite:///./data/workbuddy_admin.db
# ADMIN_DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/workbuddy_admin?charset=utf8mb4
# ADMIN_DATABASE_URL=db2+ibm_db://db2inst1:pwd@127.0.0.1:50000/WBADMIN?currentSchema=WBADMIN
#
# 其它开关（一般不用改）
ADMIN_DB_AUTO_CREATE=1      # 0 = 不再自动建库(MySQL) / schema(DB2) / 数据文件目录(SQLite)
ADMIN_DB_POOL_SIZE=20       # SQLite 忽略：它用 NullPool
ADMIN_DB_MAX_OVERFLOW=40    # SQLite 忽略
ADMIN_DB_POOL_TIMEOUT=30    # SQLite 忽略
ADMIN_DB_POOL_RECYCLE=3600  # SQLite 忽略
ADMIN_DB_CONNECT_TIMEOUT=10 # MySQL 连接超时；SQLite 上是「等写锁超时秒数」（默认取 30）
ADMIN_DB_ECHO=0             # 1 = 打印所有 SQL（排错用，会很吵）
# Windows 服务依赖的数据库服务名（service_admin.py 用，保证开机时数据库先起）
# 留空按 ADMIN_DB_TYPE 推断（mysql→MySQL84，db2→DB2-0，sqlite→无依赖），不对再手动指定
# ADMIN_DB_SERVICE_NAME=MySQL84

ADMIN_REDIS_URL=redis://127.0.0.1:6379/0

# ---------- 上游后端（CodeBuddy / WorkBuddy） ----------
ADMIN_BACKEND=https://copilot.tencent.com

# 本机桌面端登录态目录（用于后台的「扫描本机账号 / 注入本机」）
# ・单机前台运行（start_admin.bat）用下面的 %LOCALAPPDATA% 写法即可；
# ・以 Windows 服务（LocalSystem）方式运行时**必须写成绝对路径** ——
#   SYSTEM 的 %LOCALAPPDATA% 会指向 C:\Windows\system32\config\systemprofile\AppData\Local
#   （通常是空的），于是凭据一个都找不到。
#   例：ADMIN_CLIENT_AUTH_DIR=C:\Users\you\AppData\Local\CodeBuddyExtension\Data\Public\auth
#   不必为此改服务的登录账户：SYSTEM 对该目录本就有读权限。
ADMIN_CLIENT_AUTH_DIR=%LOCALAPPDATA%\CodeBuddyExtension\Data\Public\auth

# ---------- 管理后台登录 ----------
ADMIN_USERNAME=admin
# * 后台登录密码（生产必改）
ADMIN_PASSWORD=admin123
# * JWT 签名密钥，生产务必设为 >=32 字节的随机串，例如：
#   ADMIN_JWT_SECRET=$(python -c "import secrets;print(secrets.token_hex(32))")
ADMIN_JWT_SECRET=JWT_EXAMPLE_123456
ADMIN_JWT_EXPIRE_HOURS=24

# ---------- 服务监听 ----------
ADMIN_HOST=0.0.0.0
ADMIN_PORT=8790

# ---------- 假死自愈（监听器看门狗） ----------
# Windows 上 asyncio Proactor 的 accept 出错后会关闭监听 socket 且不再 accept，
# 表现为「进程活着、状态 RUNNING、但永远接不到连接」。看门狗定期发真实 HTTP
# 请求探活，连续失败即主动退出进程，交由 SCM 失败恢复策略在 5s 内重启。
# 一般不需要改；调大次数可避免弱机器上偶发误判。
ADMIN_WATCHDOG_INTERVAL=20
ADMIN_WATCHDOG_FAILURES=3

# ---------- /v1/messages（Anthropic Messages API，给 Claude Code 用） ----------
# 该端点与 /v1/chat/completions 共用同一套 Key 配额 / 用量记账 / 号池调度，
# 所以 Claude Code 也能直接吃后台号池，不必再走 /gw 那条「单账号、无配额」的旁路。
# 另提供 /v1/messages/count_tokens（本地粗估，不请求上游）。
#
# Claude Code 发的是 claude-opus-* / claude-sonnet-* / claude-haiku-* 模型名，
# 上游不认，按下面三个档次映射到本后台白名单里的模型名。
# * 不要设成 auto：本后台的 auto 是「取第一个启用的模型」，
#   在 28 个模型里可能挑到 hunyuan-chat 之类不适合写代码的，甚至图像模型。
# * 优先级提醒：若客户端（CC Switch / ~/.claude/settings.json）已经直接填了上游模型名
#   （例如 ANTHROPIC_DEFAULT_SONNET_MODEL=glm-5.2），该名字本就在白名单里，
#   会被**原样透传**，下面的档次映射根本不参与 —— 想让不同档位用不同模型，
#   直接在客户端按档位配更直观（界面显示的也会是真实模型）。
#   下面的映射只在客户端发 claude-* 这类上游不认识的名字时兜底。
ADMIN_ANTHROPIC_MODEL_OPUS=deepseek-v4-pro
ADMIN_ANTHROPIC_MODEL_SONNET=glm-5.2
ADMIN_ANTHROPIC_MODEL_HAIKU=glm-5.3-flash
#
# harness 脱敏开关。Claude Code 的 system prompt / tools 是固定模板，内含
# "DoS attacks / exploit development / credential testing" 这类**拒绝作恶**的合规声明，
# 会被上游内容审核当成敏感内容，整条请求被拒，报错就是：
#   400 {"code":11128,"msg":"Illegal API invocation from an unapproved channel"}
# 开启后会压缩 harness 并给敏感词插零宽空格（模型读到的仍是原词，后端关键词匹配失效）。
# * 默认必须开。关掉的话，简单 hello 测试能过、真实 Claude Code 请求必被拦。
ADMIN_ANTHROPIC_DESENSITIZE=1
# 配合上项：只做零宽脱敏、跳过 harness 压缩（保留 system 原文，误拦风险略高）
ADMIN_ANTHROPIC_NO_COMPACT=0

# ---------- OpenAI 协议端点的 harness 脱敏（默认关） ----------
# 上面那套脱敏默认只作用于 /v1/messages。如果你用 **OpenAI 协议**接入「长 harness 客户端」
# —— Pi、claude-code-router，以及各种「套壳 Claude Code」方案 —— 它们的 system prompt
# 同样含 DoS / exploit / credential 这类合规声明词，会撞上同一个
#   400 {"code":11128,"msg":"Illegal API invocation from an unapproved channel"}
# 这时把下面这项开成 1 即可，作用范围是 /v1/chat/completions 与 /v1/responses。
# 普通短 prompt 客户端（Cherry Studio / LobeChat / NextChat…）**不需要开**：
# 脱敏会压缩 harness 并插入零宽空格，对短 prompt 没有收益，还会无谓改动提示词。
ADMIN_OPENAI_DESENSITIZE=0

# ---------- 内嵌 /gw 网关（OpenAI / Anthropic / Responses 三种协议） ----------
# 端点：/gw/v1/chat/completions、/gw/v1/responses、/gw/v1/messages（Claude Code 用）、
#       /gw/v1/models、/gw/v1/balance、/gw/health
# * 网关要求携带的 API Key（X-Api-Key: xxx 或 Authorization: Bearer xxx）。
#   留空 = 完全不鉴权，而服务默认监听 0.0.0.0，等于把账号额度向整个网络开放，务必设置。
CONVERTER_API_KEY=
# 内嵌 /gw 读取桌面端登录凭据的目录。
# 注意：这与上面的 ADMIN_CLIENT_AUTH_DIR 是两个不同的变量 ——
#   ADMIN_CLIENT_AUTH_DIR 给后台「扫描本机 / 注入切换」用；
#   CODEBUDDY_AUTH_DIR    给 converter 找凭据用。
# 留空则按当前用户的 %LOCALAPPDATA%\CodeBuddyExtension\Data\Public\auth 推断；
# 若本服务以 SYSTEM 等非桌面登录账户运行，必须显式指定，否则 /gw 会全部返回 503。
# CODEBUDDY_AUTH_DIR=%LOCALAPPDATA%\CodeBuddyExtension\Data\Public\auth
# 内嵌 /gw 的脱敏开关与日志路径（默认启用脱敏）
CONVERTER_DESENSITIZE=1
# CONVERTER_LOG=logs/converter-embedded.log

# ---------- 计费估算（上游未回传 credits 时的兜底系数，每千 token 积分） ----------
ADMIN_COST_PER_TOKEN=0.01

# ---------- 上游请求头 ----------
# 上游记录客户端 IP 时使用的 header 名；留空则发送常见头（X-Forwarded-For 等）
ADMIN_UPSTREAM_CLIENT_HEADER=
# 上游用量「client」列显示的产品名（X-IDE-Name）
ADMIN_UPSTREAM_CLIENT_NAME=WorkBuddy

# ---------- 客户端身份画像（决定出站 User-Agent 与 X-Device-Token）----------
# 官方两个客户端（WorkBuddy 桌面端 / CodeBuddy CLI）在服务端是同一套客户端：
# platform 都是 CLI、X-Product 都是 SaaS、prefixPath 都是 /plugin。
# 出站请求里**只有两处差异**：UA 里的产品名，以及桌面端会带 X-Device-Token（CLI 不带）。
#
# 身份按每份凭据自身的 auth.domain 自动推断（含 workbuddy → 桌面端，其它 → CLI），
# 无需配置、不落库；本变量仅作 domain 缺失时的兜底。
# workbuddy = WorkBuddy 桌面端；codebuddy = CodeBuddy CLI。
ADMIN_UPSTREAM_CLIENT_KIND=workbuddy

# 两个身份各自的出站 UA。官方格式为 `{platform}/{版本} {productName}/{版本}`。
#   codebuddy 的版本号是本机实测值（取自 CodeBuddy CLI 真实请求日志）。
#   workbuddy 的版本号是按官方拼装规则与其 product.json 推断的（桌面端不打印 API 请求头，
#   无法从日志确认），默认用应用版本。**客户端升级后请同步改这两个值。**
# 想完全恢复本项目的旧行为（所有账号用同一个自造 UA）可设：
#   ADMIN_UA_WORKBUDDY=codebuddy2openai/2.0
ADMIN_UA_WORKBUDDY=CLI/5.3.14 WorkBuddy/5.3.14
ADMIN_UA_CODECLI=CLI/2.148.0 CodeBuddy/2.148.0

# ---------- 设备指纹头（X-Machine-ID / X-Session-ID / X-Request-ID）----------
# 与上面的 X-Device-Token 是**两套不同机制**，别混：
#   X-Device-Token 由桌面端 Turing Shield SDK 生成，**必须本机装桌面端**才拿得到，
#     容器 / 云端（Sealos）拿不到时自动降级为不带该头；
#   下面三个头由账号 uid 纯哈希派生（md5("<salt>:<uid>")[:36]，见 core/fingerprint.py），
#     **不依赖任何外部组件**，因此任何部署环境都能注入。
#
# 收益是「同一账号长期表现为同一台设备 + 不同账号彼此隔离」，降低多号关联风控。
# 算法口径与参考实现 workbuddy2api-hub 的 wb_fingerprint.py 逐字对齐 —— 换端或
# 混用同一号池时，同一 uid 必须派生出相同标识，否则同一账号在两套程序下被看成两台设备。
#
# 默认 on。**升级后若发现上游对新头敏感，把这一行改成 off 即可完全恢复升级前的
# 出站行为，无需改代码。** 代价：关掉后不再有设备特征隔离，多账号共用同一
# 「无设备特征」画像，防关联能力回到升级前水平。
ADMIN_DEVICE_FINGERPRINT=on

# ---------- 账号选择策略 ----------
# remain（剩余最多优先）/ lru（最久未用优先）
ADMIN_ACCOUNT_SELECT=remain

# ---------- 登录防爆破 ----------
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_SECONDS=300
ADMIN_LOGIN_LOCK_SECONDS=900

# ---------- CORS ----------
# 留空或 * 表示允许任意来源；限制可设 ADMIN_CORS_ORIGINS=https://a.com,https://b.com
ADMIN_CORS_ORIGINS=*
