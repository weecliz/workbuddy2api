# workbuddy2api 本地环境配置（本文件已被 .gitignore 忽略，不会提交）
# 生成时间: 2026-09-11

# ---------- 数据库 / 缓存 ----------
# MySQL：库不存在会自动创建，无需手动建库
ADMIN_DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/workbuddy_admin?charset=utf8mb4
# Redis：可选。连不上会自动降级为进程内内存限流
ADMIN_REDIS_URL=redis://127.0.0.1:6379/0

# ---------- 上游后端 ----------
ADMIN_BACKEND=https://copilot.tencent.com
#相对路径
#ADMIN_CLIENT_AUTH_DIR=%LOCALAPPDATA%\CodeBuddyExtension\Data\Public\auth
# 绝对路径 如果是以后太服务的方式启动 必须使用据对路径
ADMIN_CLIENT_AUTH_DIR=C:/Users/weichao/AppData/Local/CodeBuddyExtension/Data/Public/auth

# ---------- 管理后台登录 ----------
ADMIN_USERNAME=admin
# 生产/对外暴露前请改掉
ADMIN_PASSWORD=admin123
# 已生成为强随机串（>=32 字节）
ADMIN_JWT_SECRET=8875a3ff9c1e91a3bb3fa0fd6058af7c2c6e5b25e60cb5f83a1bb001d8fd4371
ADMIN_JWT_EXPIRE_HOURS=24

# ---------- 服务监听 ----------
ADMIN_HOST=0.0.0.0
ADMIN_PORT=8790

# ---------- 计费估算 ----------
ADMIN_COST_PER_TOKEN=0.01

# ---------- 上游请求头 ----------
ADMIN_UPSTREAM_CLIENT_HEADER=
ADMIN_UPSTREAM_CLIENT_NAME=WorkBuddy

# ---------- 账号选择策略 ----------
ADMIN_ACCOUNT_SELECT=remain

# ---------- 登录防爆破 ----------
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_SECONDS=300
ADMIN_LOGIN_LOCK_SECONDS=900

# ---------- CORS ----------
ADMIN_CORS_ORIGINS=*

# ---------- 内嵌 /gw 网关（Anthropic / Claude Code，CC Switch 用）----------
# 留空 = 不鉴权；已设置则 /gw/v1/* 需要 X-Api-Key 或 Authorization: Bearer
CONVERTER_API_KEY=sk-8af53b85f46c2ea162a4bab2c47393089a56f5eee15a81d6

# converter(/gw) 读取桌面端凭据的目录。
# 与 ADMIN_CLIENT_AUTH_DIR 是两个不同的变量：那个给后台「扫描/注入」用，这个给 /gw 用。
# 服务以 LocalSystem 运行时务必写绝对路径（SYSTEM 的 %LOCALAPPDATA% 是空的）。
CODEBUDDY_AUTH_DIR=C:/Users/weichao/AppData/Local/CodeBuddyExtension/Data/Public/auth
